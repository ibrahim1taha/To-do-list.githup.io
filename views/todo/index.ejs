<!DOCTYPE html>
<html>
<meta charset="UTF-8" />
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css">
<body>
    <div class="container">
        <h1><%= appTitle %></h1>
        <form id="form1">
            <input type="text" id="taskinp" placeholder="Enter a task" required>
            <button type="submit" id="pushdata">Add Task</button>
        </form>
        <ul id="taskList">
            <% tasks.forEach(function(task) { %>
                <li><%= task %></li>
            <% }); %>
        </ul>
    </div>
    <script src="/js/script.js"></script>
</body>
</html>
